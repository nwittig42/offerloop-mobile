{
  "expo": {
    "name": "Offerloop",
    "slug": "offerloop-mobile",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "offerloop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.offerloop.app",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "googlegmail"
        ],
        "NSPhotoLibraryUsageDescription": "Offerloop only accesses photos you explicitly choose to attach (for example a profile image). It never scans or uploads your photo library."
      }
    },
    "android": {
      "package": "ai.offerloop.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.184607281467-661o4ssj1i4amchot8dls7btlrp7nj99"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/offerloop-mark.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Offerloop uses the camera to scan a LinkedIn QR code at career fairs and start a meeting prep."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Offerloop uses the microphone so you can talk to Scout \u2014 ask for drafts, research, and applications by voice.",
          "speechRecognitionPermission": "Offerloop transcribes your voice so Scout can act on what you ask. Transcription starts on your device; short clips may also be sent securely to Offerloop's servers for a more accurate read. Never used for ads, never sold."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://offerloop-staging.onrender.com",
      "posthogKey": "phc_rnG5BFvMaxqNrdDFPGcXpAQxgsUGvxpYcuo7hEZqM8Wo",
      "posthogHost": "https://data.offerloop.ai",
      "eas": {
        "projectId": "c2498b56-5d1c-4d17-bea7-b319b137541e"
      },
      "firebase": {
        "apiKey": "AIzaSyCxcZbNwbh09DFw70tBQUSoqBIDaXNwZdE",
        "authDomain": "offerloop-native.firebaseapp.com",
        "projectId": "offerloop-native",
        "storageBucket": "offerloop-native.firebasestorage.app",
        "messagingSenderId": "184607281467",
        "appId": "1:184607281467:web:eab1b0e8be341aa8c5271e"
      },
      "router": {}
    },
    "owner": "rylanbohnett",
    "updates": {
