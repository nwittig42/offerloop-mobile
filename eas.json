{
  "cli": {
    "version": ">= 20.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://offerloop-staging.onrender.com",
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_AbwRUeFzOscwAUNHMCiJtxUsKBg"
      },
      "channel": "preview"
    },
    "preview-testflight": {
      "extends": "preview",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://offerloop-staging.onrender.com",
        "EXPO_PUBLIC_REVIEWER_EMAILS": "applereview@offerloop.ai"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6789441106"
      }
    },
    "preview-testflight": {
      "ios": {
        "ascAppId": "6795695227"
      }
    }
  }
}
